{
    "version"   : 3,
    "configurePresets" : [
        {
            // Configuration common to all available presets.
            "name"           : "default",
            "hidden"         : true,
            "binaryDir"      : "${sourceDir}/build-with-${presetName}",
            "cacheVariables" : {
                "CMAKE_BUILD_TYPE"     : "Release",
                "CMAKE_CXX_STANDARD"   : "20",
                "CMAKE_CXX_EXTENSIONS" : "OFF",
                "BUILD_SHARED_LIBS"    : "ON",
                "CMAKE_C_COMPILER"     : "should-not-be-needed",
                "Kokkos_ENABLE_SERIAL" : "ON",
                "Kokkos_ENABLE_TESTS"  : "OFF"
            }
        },
        {
            // Inherit from this preset to use the gcc compiler family.
            "name"           : "gcc",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "g++"}
        },
        {
            // Inherit from this preset to use the clang compiler family.
            "name"           : "clang",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "clang++"},
            "environment" : {
                // If the compiler is Clang, we need to explicitly link to the atomic library, as
                // stated in https://clang.llvm.org/docs/Toolchain.html#atomics-library.
                // We are not sure why this is needed, i.e. why we don't get this automatically from
                // Kokkos or HPX.
                "LDFLAGS" : "-latomic"
            }
        },
        {
            // Inherit from this preset to use the ROCm compiler family.
            "name"           : "rocm",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "hipcc"}
        },
        {
            // Inherit from this preset to use the OpenMP backend.
            "name"           : "OpenMP",
            "hidden"         : true,
            "cacheVariables" : {"Kokkos_ENABLE_OPENMP" : "ON"}
        },
        {
            // Inherit from this preset to use the HPX backend.
            "name"           : "HPX",
            "hidden"         : true,
            "cacheVariables" : {"Kokkos_ENABLE_HPX" : "ON"}
        },
        {
            // Inherit from this preset to use the Cuda backend.
            "name"           : "Cuda",
            "hidden"         : true,
            "cacheVariables" : {
                    "Kokkos_ENABLE_CUDA"           : "ON",
                    "Kokkos_ENABLE_CUDA_CONSTEXPR" : "ON",
                    REPL_STR_KOKKOS_ARCH_ENABLED
                    "Kokkos_ENABLE_IMPL_CUDA_MALLOC_ASYNC" : "ON"
            }
        },
        {
            // Inherit from this preset to use the HIP backend.
            "name"           : "HIP",
            "hidden"         : true,
            "cacheVariables" : {
                "Kokkos_ENABLE_HIP"            : "ON",
                "Kokkos_ENABLE_ROCTHRUST"      : "OFF",
                REPL_STR_KOKKOS_ARCH_ENABLED
                "Kokkos_ENABLE_IMPL_HIP_MALLOC_ASYNC" : "ON"
            }
        },
        {
            "name"     : "gcc-OpenMP",
            "inherits" : ["default", "gcc", "OpenMP"]
        },
        {
            "name"     : "clang-OpenMP",
            "inherits" : ["default", "clang", "OpenMP"]
        },
        {
            "name"     : "clang-HPX",
            "inherits" : ["default", "clang", "HPX"]
        },
        {
            "name"     : "gcc-Cuda",
            "inherits" : ["default", "gcc", "OpenMP", "Cuda"]
        },
        {
            "name"     : "clang-Cuda",
            "inherits" : ["default", "clang", "OpenMP", "Cuda"]
        },
        {
            "name"     : "clang-HPX-Cuda",
            "inherits" : ["default", "clang", "HPX", "Cuda"]
        },
        {
            "name"     : "rocm-HIP",
            "inherits" : ["default", "rocm", "OpenMP", "HIP"]
        }
    ],
    "buildPresets" : [
        {
            "name"            : "default",
            "configurePreset" : "default",
            "inheritConfigureEnvironment" : true
        }
    ]
}
