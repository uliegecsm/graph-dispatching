{
    "version"   : 3,
    "configurePresets" : [
        {
            "name"           : "default",
            "binaryDir"      : "${sourceDir}/build-with-${presetName}",
            "cacheVariables" : {
                "CMAKE_BUILD_TYPE"     : "Release",
                "CMAKE_CXX_STANDARD"   : "20",
                "CMAKE_CXX_EXTENSIONS" : "OFF",
                "BUILD_SHARED_LIBS"    : "ON",
                "CMAKE_C_COMPILER"     : "should-not-be-needed",
                "CMAKE_CXX_COMPILER"   : "g++",
                "Kokkos_ENABLE_SERIAL" : "ON",
                "Kokkos_ENABLE_OPENMP" : "ON",
                "Kokkos_ENABLE_TESTS"  : "OFF"
            }
        },
        {
            "name"     : "gcc-OpenMP",
            "inherits" : "default"
        },
        {
            "name"           : "clang-OpenMP",
            "inherits"       : "default",
            "cacheVariables" : {
                "CMAKE_CXX_COMPILER" : "clang++"
            }
        },
        {
            "name"           : "clang-HPX",
            "inherits"       : "clang-OpenMP",
            "cacheVariables" : {
                "Kokkos_ENABLE_HPX"    : "ON",
                "Kokkos_ENABLE_OPENMP" : "OFF"
            }
        },
        {
            "name"           : "gcc-Cuda",
            "inherits"       : "default",
            "cacheVariables" : {
                "Kokkos_ENABLE_CUDA"           : "ON",
                "Kokkos_ENABLE_CUDA_CONSTEXPR" : "ON",
                "Kokkos_ARCH_VOLTA70"          : "ON"
            }
        }
    ],
    "buildPresets" : [
        {
            "name"            : "default",
            "configurePreset" : "default",
            "inheritConfigureEnvironment" : true
        },
        {
            "name"            : "gcc-OpenMP",
            "configurePreset" : "gcc-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-OpenMP",
            "configurePreset" : "clang-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-HPX",
            "configurePreset" : "clang-HPX",
            "inherits"        : "default"
        },
        {
            "name"            : "gcc-Cuda",
            "configurePreset" : "gcc-Cuda",
            "inherits"        : "default"
        }
    ]
}
