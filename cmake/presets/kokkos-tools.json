{
    "version"   : 5,
    "configurePresets" : [
        {
            // Configuration common to all available presets.
            "name"          : "default",
            "hidden"        : true,
            "binaryDir"     : "${sourceDir}/build-with-${presetName}",
            "cacheVariables" : {
                "CMAKE_BUILD_TYPE"   : "Release",
                "CMAKE_CXX_STANDARD" : "20",
                "CMAKE_C_COMPILER"   : "not-needed"
            }
        },
        {
            // Inherit from this preset to use the gnu compiler family.
            "name"           : "gnu",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "g++"}
        },
        {
            // Inherit from this preset to use the clang compiler family.
            "name"           : "clang",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "clang++"}
        },
        {
            // Inherit from this preset to use the ROCm compiler family.
            "name"           : "rocm",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "hipcc"}
        },
        {
            "name"     : "gnu-OpenMP",
            "inherits" : ["default", "gnu"]
        },
        {
            "name"     : "clang-OpenMP",
            "inherits" : ["default", "clang"]
        },
        {
            "name"     : "clang-HPX",
            "inherits" : ["default", "clang"]
        },
        {
            "name"     : "gnu-Cuda",
            "inherits" : ["default", "gnu"]
        },
        {
            "name"     : "clang-Cuda",
            "inherits" : ["default", "clang"]
        },
        {
            "name"     : "clang-HPX-Cuda",
            "inherits" : ["default", "clang"]
        },
        {
            "name"        : "rocm-HIP",
            "inherits"    : ["default", "rocm"],
            "environment" : {
                "ROCM_PATH" : "/opt/rocm"
            }
        }
    ],
    "buildPresets" : [
        {
            "name"                        : "default",
            "configurePreset"             : "default",
            "inheritConfigureEnvironment" : true
        }
    ]
}
