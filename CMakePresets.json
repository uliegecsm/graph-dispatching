{
    "version": 10,
    "configurePresets" : [
        {
            "$comment": "Configuration common to all available presets.",
            "name"           : "default",
            "hidden"         : true,
            "binaryDir"      : "${sourceDir}/build-with-${presetName}",
            "cacheVariables" : {
                "CMAKE_BUILD_TYPE"     : "Release",
                "CMAKE_CXX_STANDARD"   : "20",
                "CMAKE_CXX_EXTENSIONS" : "OFF",
                "CMAKE_C_COMPILER"     : "should-not-be-needed"
            },
            "warnings" : {
                "dev"           : true,
                "uninitialized" : true,
                "unusedCli"     : true
            },
            "errors": {
                "deprecated" : true
            }
        },
        {
            "$comment": "Inherit from this preset to use ccache.",
            "name"           : "ccache",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER_LAUNCHER" : "ccache"}
        },
        {
            "$comment": "Inherit from this preset to use the gcc compiler family.",
            "name"           : "gcc",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "g++"}
        },
        {
            "$comment": "Inherit from this preset to use the clang compiler family.",
            "name"           : "clang",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "clang++"}
        },
        {
            "$comment": "Inherit from this preset to use clang-tidy.",
            "name"          : "clang-tidy",
            "hidden"        : true,
            "cacheVariables": {"ENABLE_CLANG_TIDY" : "ON"}
        },
        {
            "$comment": "Inherit from this preset to use the ROCm compiler family.",
            "name"           : "rocm",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "hipcc"}
        },
        {
            "$comment": "Inherit from this preset to use the Cuda compiler family.",
            "name"           : "Cuda",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "$penv{Kokkos_ROOT}/bin/nvcc_wrapper"}
        },
        {
            "$comment": "Inherit from this preset to use C++23.",
            "name" : "cxx23",
            "hidden" : true,
            "cacheVariables" : {"CMAKE_CXX_STANDARD": "23"}
        },
        {
            "name"           : "gcc-OpenMP",
            "inherits"       : ["default", "gcc", "ccache"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP"
            }
        },
        {
            "name"           : "clang-OpenMP",
            "inherits"       : ["cxx23", "default", "clang", "clang-tidy", "ccache"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP",
                "CMAKE_CXX_FLAGS": "-fsanitize=address"
            }
        },
        {
            "name"           : "clang-HPX",
            "inherits"       : ["cxx23", "default", "clang", "ccache"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;HPX",
                "CMAKE_CXX_FLAGS": "-fsanitize=address"
            }
        },
        {
            "name"           : "gcc-Cuda",
            "inherits"       : ["default", "Cuda", "ccache"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP;CUDA"
            }
        },
        {
            "name"           : "clang-Cuda",
            "inherits"       : ["cxx23", "default", "clang", "clang-tidy", "ccache"],
            "cacheVariables" : {
                "CMAKE_CXX_FLAGS"         : "-Wno-error=unknown-cuda-version",
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP;CUDA"
            }
        },
        {
            "name"           : "clang-HPX-Cuda",
            "inherits"       : ["default", "clang", "ccache"],
            "cacheVariables" : {
                "CMAKE_CXX_FLAGS"         : "-Wno-error=unknown-cuda-version",
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;HPX;CUDA"
            }
        },
        {
            "name"           : "rocm-HIP",
            "inherits"       : ["default", "rocm", "ccache"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OpenMP;HIP"
            }
        }
    ],
    "buildPresets" : [
        {
            "name"            : "default",
            "configurePreset" : "default",
            "inheritConfigureEnvironment" : true
        },
        {
            "name"            : "gcc-OpenMP",
            "configurePreset" : "gcc-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-OpenMP",
            "configurePreset" : "clang-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-HPX",
            "configurePreset" : "clang-HPX",
            "inherits"        : "default"
        },
        {
            "name"            : "gcc-Cuda",
            "configurePreset" : "gcc-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-Cuda",
            "configurePreset" : "clang-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-HPX-Cuda",
            "configurePreset" : "clang-HPX-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "rocm-HIP",
            "configurePreset" : "rocm-HIP",
            "inherits"        : "default"
        }
    ],
    "testPresets": [
        {
            "name"            : "default",
            "configurePreset" : "default",
            "inheritConfigureEnvironment" : true,
            "output"          : {"outputOnFailure": true},
            "execution"       : {
                "noTestsAction"  : "error",
                "stopOnFailure"  : false,
                "scheduleRandom" : true
            }
        },
        {
            "name"            : "gcc-OpenMP",
            "configurePreset" : "gcc-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-OpenMP",
            "configurePreset" : "clang-OpenMP",
            "inherits"        : ["default"]
        },
        {
            "name"            : "clang-HPX",
            "configurePreset" : "clang-HPX",
            "inherits"        : ["default"]
        },
        {
            "name"            : "gcc-Cuda",
            "configurePreset" : "gcc-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-Cuda",
            "configurePreset" : "clang-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-HPX-Cuda",
            "configurePreset" : "clang-HPX-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "rocm-HIP",
            "configurePreset" : "rocm-HIP",
            "inherits"        : "default"
        }
    ]
}
