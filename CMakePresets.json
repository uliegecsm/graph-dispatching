{
    "version"   : 3,
    "configurePresets" : [
        {
            // Configuration common to all available presets.
            "name"           : "default",
            "hidden"         : true,
            "binaryDir"      : "${sourceDir}/build-with-${presetName}",
            "cacheVariables" : {
                "CMAKE_BUILD_TYPE"     : "Release",
                "CMAKE_CXX_STANDARD"   : "20",
                "CMAKE_CXX_EXTENSIONS" : "OFF",
                "CMAKE_C_COMPILER"     : "should-not-be-needed"
            },
            "warnings" : {
                "uninitialized" : true,
                "unusedCli"     : true
            },
            "errors": {
                "dev"        : true,
                "deprecated" : true
            }
        },
        {
            // Inherit from this preset to use ccache.
            "name"           : "ccache",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER_LAUNCHER" : "ccache"}
        },
        {
            // Inherit from this preset to use the gcc compiler family.
            "name"           : "gcc",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "g++"}
        },
        {
            // Inherit from this preset to use the clang compiler family.
            "name"           : "clang",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "clang++"}
        },
        {
            // Inherit from this preset to use the ROCm compiler family.
            "name"           : "ROCm",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "hipcc"}
        },
        {
            // Inherit from this preset to use the Cuda compiler family.
            "name"           : "Cuda",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "$penv{Kokkos_ROOT}/bin/nvcc_wrapper"}
        },
        {
            "name"           : "gcc-OpenMP",
            "inherits"       : ["default", "gcc", "ccache"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP"
            }
        },
        {
            "name"           : "clang-OpenMP",
            "inherits"       : ["default", "clang", "ccache"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP"
            }
        },
        {
            "name"           : "clang-HPX",
            "inherits"       : ["default", "clang", "ccache"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;HPX"
            }
        },
        {
            "name"           : "gcc-Cuda",
            "inherits"       : ["default", "Cuda", "ccache"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP;CUDA"
            }
        },
        {
            "name"           : "clang-Cuda",
            "inherits"       : ["default", "clang", "ccache"],
            "cacheVariables" : {
                "CMAKE_CXX_FLAGS"         : "-Wno-error=unknown-cuda-version",
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP;CUDA"
            }
        },
        {
            "name"           : "clang-HPX-Cuda",
            "inherits"       : ["default", "clang", "ccache"],
            "cacheVariables" : {
                "CMAKE_CXX_FLAGS"         : "-Wno-error=unknown-cuda-version",
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;HPX;CUDA"
            }
        },
        {
            "name"           : "ROCm-HIP",
            "inherits"       : ["default", "ROCm", "ccache"],
            "cacheVariables" : {
                "ENABLE_MULTIGPU"         : "ON",
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OpenMP;HIP"
            }
        }
    ],
    "buildPresets" : [
        {
            "name"            : "default",
            "configurePreset" : "default",
            "inheritConfigureEnvironment" : true
        },
        {
            "name"            : "gcc-OpenMP",
            "configurePreset" : "gcc-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-OpenMP",
            "configurePreset" : "clang-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-HPX",
            "configurePreset" : "clang-HPX",
            "inherits"        : "default"
        },
        {
            "name"            : "gcc-Cuda",
            "configurePreset" : "gcc-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-Cuda",
            "configurePreset" : "clang-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-HPX-Cuda",
            "configurePreset" : "clang-HPX-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "ROCm-HIP",
            "configurePreset" : "ROCm-HIP",
            "inherits"        : "default"
        }
    ],
    "testPresets": [
        {
            "name"            : "default",
            "configurePreset" : "default",
            "inheritConfigureEnvironment" : true,
            "output"          : {"outputOnFailure": true},
            "execution"       : {
                "noTestsAction"  : "error",
                "stopOnFailure"  : false,
                "scheduleRandom" : true
            }
        },
        {
            "name"            : "gcc-OpenMP",
            "configurePreset" : "gcc-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-OpenMP",
            "configurePreset" : "clang-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-HPX",
            "configurePreset" : "clang-HPX",
            "inherits"        : "default"
        },
        {
            "name"            : "gcc-Cuda",
            "configurePreset" : "gcc-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-Cuda",
            "configurePreset" : "clang-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-HPX-Cuda",
            "configurePreset" : "clang-HPX-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "ROCm-HIP",
            "configurePreset" : "ROCm-HIP",
            "inherits"        : "default"
        }
    ]
}
