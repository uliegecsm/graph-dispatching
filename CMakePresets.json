{
    "version"   : 3,
    "configurePresets" : [
        {
            "name"          : "default",
            "binaryDir"     : "${sourceDir}/build-with-${presetName}",
            "cacheVariables" : {
                "CMAKE_BUILD_TYPE"     : "Release",
                "CMAKE_CXX_STANDARD"   : "20",
                "CMAKE_CXX_EXTENSIONS" : "OFF",
                "CMAKE_CXX_COMPILER"   : "g++"
            }
        },
        {
            "name"     : "gcc-OpenMP",
            "inherits" : "default"
        },
        {
            "name"           : "clang-OpenMP",
            "inherits"       : "default",
            "cacheVariables" : {
                "CMAKE_CXX_COMPILER" : "clang++"
            }
        },
        {
            "name"           : "clang-HPX",
            "inherits"       : "clang-OpenMP",
            "cacheVariables" : {
                "GraphDispatching_ENABLE_HPX" : "ON"
            }
        }
    ],
    "buildPresets" : [
        {
            "name"            : "default",
            "configurePreset" : "default",
            "inheritConfigureEnvironment" : true
        },
        {
            "name"            : "gcc-OpenMP",
            "configurePreset" : "gcc-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-OpenMP",
            "configurePreset" : "clang-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-HPX",
            "configurePreset" : "clang-HPX",
            "inherits"        : "default"
        }
    ],
    "testPresets": [
        {
            "name"            : "default",
            "configurePreset" : "default",
            "inheritConfigureEnvironment" : true,
            "output"          : {"outputOnFailure": true},
            "execution"       : {
                "noTestsAction"  : "error",
                "stopOnFailure"  : false,
                "scheduleRandom" : true
            }
        },
        {
            "name"            : "gcc-OpenMP",
            "configurePreset" : "gcc-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-OpenMP",
            "configurePreset" : "clang-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-HPX",
            "configurePreset" : "clang-HPX",
            "inherits"        : "default"
        }
    ]
}
