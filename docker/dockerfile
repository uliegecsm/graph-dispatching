# Compile Doxygen.
FROM requirements AS doxygen-compile

ARG DOXYGEN_VERSION

RUN <<EOF
    set -ex

    apt-helpers install-packages --clean --update --packages flex bison

    git clone --depth=1 --branch Release_$(echo ${DOXYGEN_VERSION} | tr . _) https://github.com/doxygen/doxygen doxygen

    cd doxygen

    cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/opt/doxygen-${DOXYGEN_VERSION}

    cmake --build build -j4 --target install
EOF

# Fetch https://github.com/NVIDIA/stdexec sources.
FROM requirements AS nvidia-stdexec

ARG NVIDIA_STDEXEC_REF

RUN <<EOF
    set -ex

    git clone --branch main --shallow-since=2024-06-01 https://github.com/NVIDIA/stdexec /opt/nvidia/stdexec-${NVIDIA_STDEXEC_REF}

    cd /opt/nvidia/stdexec-${NVIDIA_STDEXEC_REF}

    git checkout ${NVIDIA_STDEXEC_REF}
EOF

# Fetch https://github.com/uliegecsm/kokkos-utils sources and install.
FROM kokkos-compile AS kokkos-utils-compile

ARG KOKKOS_UTILS_BRANCH
ARG KOKKOS_UTILS_SHA

RUN --mount=target=/cmake/presets/kokkos-utils.json,type=bind,source=cmake/presets/kokkos-utils.json \
    --mount=target=/cmake/presets/generate.py,type=bind,source=cmake/presets/generate.py <<EOF
    set -ex

    git clone --branch ${KOKKOS_UTILS_BRANCH} https://github.com/uliegecsm/kokkos-utils /opt/kokkos-utils-sources

    cd /opt/kokkos-utils-sources

    git checkout ${KOKKOS_UTILS_SHA}

    python3 /cmake/presets/generate.py                 \
        --input-file  /cmake/presets/kokkos-utils.json \
        --output-file CMakePresets.json                \
        --preset ${KOKKOS_PRESET}

    export Kokkos_ROOT=/opt/kokkos-${KOKKOS_SHA}/${KOKKOS_PRESET}

    cmake -S . --preset=${KOKKOS_PRESET} \
        -DCMAKE_INSTALL_PREFIX=/opt/kokkos-utils/${KOKKOS_PRESET}

    cmake --build --preset=${KOKKOS_PRESET} -j4 --target=install
EOF

# Build the final image from previous stages.
FROM requirements-backend AS final

ARG DOXYGEN_VERSION
ARG GOOGLEBENCHMARK_VERSION
ARG GOOGLETEST_VERSION
ARG HPX_REF
ARG KOKKOS_KERNELS_SHA
ARG KOKKOS_PRESET
ARG KOKKOS_SHA
ARG NVIDIA_STDEXEC_REF

COPY --from=doxygen-compile /opt/doxygen-${DOXYGEN_VERSION} /opt/doxygen-${DOXYGEN_VERSION}

COPY --from=google-benchmark-compile /opt/google-benchmark-${GOOGLEBENCHMARK_VERSION} /opt/google-benchmark-${GOOGLEBENCHMARK_VERSION}

COPY --from=google-test-compile    /opt/google-test-${GOOGLETEST_VERSION}                     /opt/google-test-${GOOGLETEST_VERSION}
COPY --from=hpx-compile            /opt/hpx-${HPX_REF}                                        /opt/hpx-${HPX_REF}
COPY --from=kokkos-compile         /opt/kokkos-${KOKKOS_SHA}/${KOKKOS_PRESET}                 /opt/kokkos-${KOKKOS_SHA}/${KOKKOS_PRESET}
COPY --from=kokkos-kernels-compile /opt/kokkos-kernels-${KOKKOS_KERNELS_SHA}/${KOKKOS_PRESET} /opt/kokkos-kernels-${KOKKOS_KERNELS_SHA}/${KOKKOS_PRESET}
COPY --from=kokkos-tools-compile   /opt/kokkos-tools/${KOKKOS_PRESET}                         /opt/kokkos-tools/${KOKKOS_PRESET}
COPY --from=kokkos-utils-compile   /opt/kokkos-utils/${KOKKOS_PRESET}                         /opt/kokkos-utils/${KOKKOS_PRESET}
COPY --from=nvidia-stdexec         /opt/nvidia/stdexec-${NVIDIA_STDEXEC_REF}                  /opt/nvidia/stdexec-${NVIDIA_STDEXEC_REF}

ENV benchmark_ROOT=/opt/google-benchmark-${GOOGLEBENCHMARK_VERSION}
ENV Doxygen_ROOT=/opt/doxygen-${DOXYGEN_VERSION}
ENV GTest_ROOT=/opt/google-test-${GOOGLETEST_VERSION}
ENV HPX_ROOT=/opt/hpx-${HPX_REF}
ENV Kokkos_ROOT=/opt/kokkos-${KOKKOS_SHA}/${KOKKOS_PRESET}
ENV KokkosKernels_ROOT=/opt/kokkos-kernels-${KOKKOS_KERNELS_SHA}/${KOKKOS_PRESET}
ENV KokkosUtils_ROOT=/opt/kokkos-utils/${KOKKOS_PRESET}
ENV Stdexec_ROOT=/opt/nvidia/stdexec-${NVIDIA_STDEXEC_REF}
