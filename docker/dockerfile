ARG BASE_IMAGE=not-given
ARG COMPILER_FAMILY=not-given

# Install Python3 (with the trickery for virtual environment).
FROM ${BASE_IMAGE} AS requirements-python

ARG PYTHON_VERSION=3.12
ENV VIRTUAL_ENV=/opt/venv-${PYTHON_VERSION}
ENV PATH=${VIRTUAL_ENV}/bin:${PATH}

RUN <<EOF
    set -ex
    apt update
    apt --yes --no-install-recommends install python3 python3-pip python3-venv git
    python3 -m venv $VIRTUAL_ENV

    printf "import re, sys\nif re.match(r'Python ${PYTHON_VERSION}.[0-9]+', '$(python3 --version)') is None: raise RuntimeError(f'Your Python version {sys.version} does not match ${PYTHON_VERSION}.')" | python3

    python3 -m pip install system-helpers>=0.0.3

    apt clean && rm -rf /var/lib/apt/lists/*
EOF

FROM requirements-python AS requirements-cmake

ARG TARGETARCH
ARG CMAKE_VERSION

RUN <<EOF
    set -ex

    apt-helpers install-packages --update --clean --packages wget

    if [ "${TARGETARCH}" = "amd64" ];then
        SUFFIX=x86_64
    elif [ "${TARGETARCH}" = "arm64" ];then
        SUFFIX=aarch64
    else
        echo "unsupported target arch ${TARGETARCH}"
    fi

    INSTALLER=cmake-${CMAKE_VERSION}-linux-${SUFFIX}.sh

    wget https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/${INSTALLER}

    mkdir -p /opt/cmake-${CMAKE_VERSION}

    sh ${INSTALLER} --skip-license --prefix=/opt/cmake-${CMAKE_VERSION}/

    rm ${INSTALLER}
EOF

ARG CMAKE_PACKAGE_MANAGER_VERSION
ARG CMAKE_PACKAGE_MANAGER_SHA256

ADD --checksum=sha256:${CMAKE_PACKAGE_MANAGER_SHA256} \
    https://github.com/cpm-cmake/CPM.cmake/releases/download/v${CMAKE_PACKAGE_MANAGER_VERSION}/CPM.cmake \
    /opt/cpm-${CMAKE_PACKAGE_MANAGER_VERSION}/

ENV PATH=/opt/cmake-${CMAKE_VERSION}/bin:${PATH}

FROM requirements-cmake AS requirements-compiler-rocm

ENV PATH=/opt/rocm/bin:${PATH}

FROM requirements-cmake AS requirements-compiler-gnu

ARG COMPILER_VERSION

RUN <<EOF
    set -ex

    apt-helpers install-packages --clean --update --packages gcc-${COMPILER_VERSION} g++-${COMPILER_VERSION}

    update-alternatives-helpers --prefix /usr/bin \
        --display --level=10 \
        --for-each-of \
            gcc=gcc-${COMPILER_VERSION} \
            g++=g++-${COMPILER_VERSION} \
            $(uname -m)-linux-gnu-gcc=$(uname -m)-linux-gnu-gcc-${COMPILER_VERSION} \
            $(uname -m)-linux-gnu-g++=$(uname -m)-linux-gnu-g++-${COMPILER_VERSION}

    gcc -dumpfullversion -dumpversion
    g++ -dumpfullversion -dumpversion
EOF

FROM requirements-cmake AS requirements-compiler-clang

ARG COMPILER_VERSION

RUN <<EOF
    set -ex

    apt-helpers install-packages --update --packages wget lsb-release gpg software-properties-common

    wget https://apt.llvm.org/llvm.sh
    chmod +x llvm.sh
    ./llvm.sh ${COMPILER_VERSION}
    rm llvm.sh

    apt-helpers install-packages --clean \
        --update --packages              \
        clang-${COMPILER_VERSION}           \
        clang-tidy-${COMPILER_VERSION}      \
        clang-format-${COMPILER_VERSION}    \
        libomp-${COMPILER_VERSION}-dev

    update-alternatives-helpers --prefix /usr/bin --level 10 \
        --display --for-each-of                              \
        clang=clang-${COMPILER_VERSION}                         \
        clang++=clang++-${COMPILER_VERSION}                     \
        clang-tidy=clang-tidy-${COMPILER_VERSION}
EOF

FROM requirements-compiler-${COMPILER_FAMILY} AS requirements

RUN --mount=target=/requirements,type=bind,source=requirements <<EOF
    set -ex

    apt-helpers install-packages --clean --update           \
        --requirement /requirements/requirements.system.txt \
        --requirement /requirements/requirements.system.doc.txt \
        --requirement /requirements/requirements.system.hpx.txt

    python3 -m pip install -r /requirements/requirements.python.benchmarks.txt
EOF

FROM requirements AS requirements-backend

ARG BACKEND=notset

RUN --mount=target=/docker/backend.py,type=bind,source=docker/backend.py \
    --mount=target=/version.json,type=bind,source=version.json \
    python3 /docker/backend.py --backend=${BACKEND} --version-file=version.json

# Compile Google Test.
FROM requirements AS google-test-compile

ARG GOOGLETEST_VERSION

RUN <<EOF
    set -ex

    git clone --depth=1 --branch=v${GOOGLETEST_VERSION} https://github.com/google/googletest googletest

    cd googletest

    cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/google-test-${GOOGLETEST_VERSION}

    cmake --build build -j4

    cmake --build build --target install
EOF

# Compile Google Benchmark.
FROM requirements AS google-benchmark-compile

ARG GOOGLEBENCHMARK_VERSION

RUN <<EOF
    set -ex

    git clone --depth=1 --branch=min_rel_accuracy https://github.com/uliegecsm/benchmark googlebenchmark

    cd googlebenchmark

    git checkout f649efee480295b01a04bf077cdd50b3293d56c5

    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/opt/google-benchmark-${GOOGLEBENCHMARK_VERSION} \
        -DCMAKE_BUILD_TYPE=Release \
        -DBENCHMARK_ENABLE_TESTING=OFF \
        -DBENCHMARK_INSTALL_DOCS=OFF

    cmake --build build -j4

    cmake --build build --target install
EOF

# Fetch HPX sources, configure, build and install.
FROM requirements AS hpx-compile

ARG COMPILER_FAMILY
ARG HPX_REF
ARG HPX_SOURCE_DIR=/opt/hpx-${HPX_REF}-sources/

RUN git clone --depth=1 --branch=${HPX_REF} -- https://github.com/STELLAR-GROUP/hpx.git ${HPX_SOURCE_DIR}

RUN --mount=target=/cmake/presets/hpx.json,type=bind,source=cmake/presets/hpx.json \
    --mount=target=/cmake/presets/generate.py,type=bind,source=cmake/presets/generate.py <<EOF
    set -ex

    if [ "${TARGETARCH}" = "amd64" ];then
        ADDITIONAL_CONFIG_ARGS=
    elif [ "${TARGETARCH}" = "arm64" ];then
        # This option seems needed for ARM.
        # https://hpx-docs.stellar-group.org/latest/html/manual/building_hpx.html#cmdoption-arg-HPX_WITH_GENERIC_CONTEXT_COROUTINES
        ADDITIONAL_CONFIG_ARGS=-DHPX_WITH_GENERIC_CONTEXT_COROUTINES:BOOL=ON
    else
        echo "unsupported target arch ${TARGETARCH}"
        exit -1
    fi

    cd ${HPX_SOURCE_DIR}

    python3 /cmake/presets/generate.py        \
        --input-file  /cmake/presets/hpx.json \
        --output-file CMakePresets.json       \
        --preset      ${COMPILER_FAMILY}

    cmake -S . --preset=${COMPILER_FAMILY} ${ADDITIONAL_CONFIG_ARGS}
    cmake --build --preset=${COMPILER_FAMILY} -j4
    cmake --install build-with-${COMPILER_FAMILY} --prefix=/opt/hpx-${HPX_REF}/
EOF

# Compile Kokkos.
FROM hpx-compile AS kokkos-compile

ARG KOKKOS_ARCHS
ARG KOKKOS_BRANCH
ARG KOKKOS_PRESET
ARG KOKKOS_SHA
ARG KOKKOS_URL=kokkos

RUN git clone --shallow-since=2024-08-05 --branch=${KOKKOS_BRANCH} https://github.com/${KOKKOS_URL}/kokkos /kokkos-sources

RUN --mount=target=/patches/kokkos-clang-cuda-unreachable.patch,type=bind,source=docker/patches/kokkos-clang-cuda-unreachable.patch \
    --mount=target=/cmake/presets/kokkos.json,type=bind,source=cmake/presets/kokkos.json \
    --mount=target=/cmake/presets/kokkos.py,type=bind,source=cmake/presets/kokkos.py \
    --mount=target=/cmake/presets/generate.py,type=bind,source=cmake/presets/generate.py <<EOF
    set -ex

    cd /kokkos-sources

    git checkout ${KOKKOS_SHA}

    patch -p1 < /patches/kokkos-clang-cuda-unreachable.patch

    python3 /cmake/presets/kokkos.py \
        --input-file  /cmake/presets/kokkos.json \
        --output-file CMakePresets.json \
        --kokkos-archs=${KOKKOS_ARCHS}

    python3 /cmake/presets/generate.py  \
        --input-file  CMakePresets.json \
        --output-file CMakePresets.json \
        --preset      ${KOKKOS_PRESET}

    # For Cuda 13, we need to disable 'mdspan', see also https://github.com/kokkos/kokkos/pull/8562.
    if [ -n "$CUDA_VERSION" ] && [ "${CUDA_VERSION%%.*}" -ge 13 ]; then
        cmake_args="-DKokkos_ENABLE_IMPL_MDSPAN=OFF"
    else
        cmake_args=""
    fi

    cmake -S . --preset=${KOKKOS_PRESET} \
        ${cmake_args} \
        -DCMAKE_INSTALL_PREFIX=/opt/kokkos-${KOKKOS_SHA}/${KOKKOS_PRESET}

    cmake --build --preset=${KOKKOS_PRESET} -j4 --target=install
EOF

# Compile Kokkos Kernels.
FROM kokkos-compile AS kokkos-kernels-compile

ARG KOKKOS_KERNELS_BRANCH
ARG KOKKOS_KERNELS_SHA

RUN git clone --shallow-since=2024-08-05 --branch=${KOKKOS_KERNELS_BRANCH} https://github.com/kokkos/kokkos-kernels /kokkos-kernels-sources

RUN --mount=target=/cmake/presets/kokkos-kernels.json,type=bind,source=cmake/presets/kokkos-kernels.json \
    --mount=target=/cmake/presets/generate.py,type=bind,source=cmake/presets/generate.py <<EOF
    set -ex

    cd /kokkos-kernels-sources

    git checkout ${KOKKOS_KERNELS_SHA}

    python3 /cmake/presets/generate.py                   \
        --input-file  /cmake/presets/kokkos-kernels.json \
        --output-file CMakePresets.json                  \
        --preset      ${KOKKOS_PRESET}

    export Kokkos_ROOT=/opt/kokkos-${KOKKOS_SHA}/${KOKKOS_PRESET}

    cmake -S . --preset=${KOKKOS_PRESET} \
        -DCMAKE_INSTALL_PREFIX=/opt/kokkos-kernels-${KOKKOS_KERNELS_SHA}/${KOKKOS_PRESET}

    cmake --build --preset=${KOKKOS_PRESET} -j4 --target=install
EOF

